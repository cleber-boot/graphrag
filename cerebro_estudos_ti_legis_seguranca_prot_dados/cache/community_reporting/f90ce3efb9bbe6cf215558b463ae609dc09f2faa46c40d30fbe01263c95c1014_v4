liance.\"\n  }"}, "metrics": {"attempted_request_count": 1, "successful_response_count": 0, "failed_response_count": 0, "responses_with_tokens": 1, "prompt_tokens": 2862, "completion_tokens": 7133, "total_tokens": 9995, "compute_duration_seconds": 33.51804828643799, "streaming_responses": 0, "retries": 0, "requests_with_retries": 0}}}